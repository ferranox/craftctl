#!/usr/bin/env bash
# craftctl - lib/systemd
# systemd service management for per-server units.
# shellcheck shell=bash

service_name_for() {
    local name="$1"
    printf 'craftctl@%s.service\n' "$name"
}

systemd_unit_path() {
    local name="$1"
    printf '%s/%s\n' "$CRAFTCTL_SYSTEMD_DIR" "$(service_name_for "$name")"
}

systemctl_cmd() {
    if is_root; then
        systemctl "$@"
    elif has_cmd sudo; then
        sudo systemctl "$@"
    else
        systemctl "$@"
    fi
}

service_is_active() {
    local name="$1"
    systemctl_cmd is-active --quiet "$(service_name_for "$name")" 2>/dev/null
}

service_is_enabled() {
    local name="$1"
    systemctl_cmd is-enabled --quiet "$(service_name_for "$name")" 2>/dev/null
}

service_start() {
    local name="$1"
    systemctl_cmd start "$(service_name_for "$name")"
}

service_stop() {
    local name="$1"
    systemctl_cmd stop "$(service_name_for "$name")"
}

service_restart() {
    local name="$1"
    systemctl_cmd restart "$(service_name_for "$name")"
}

service_enable() {
    local name="$1"
    systemctl_cmd enable "$(service_name_for "$name")"
}

service_disable() {
    local name="$1"
    systemctl_cmd disable "$(service_name_for "$name")" 2>/dev/null || true
}

service_status_text() {
    local name="$1"
    systemctl_cmd status "$(service_name_for "$name")" --no-pager 2>&1 || true
}

install_service_template() {
    local src="$1"
    local dest="${CRAFTCTL_SYSTEMD_DIR}/craftctl@.service"
    [[ -f "$src" ]] || { log_error "Service template not found: ${src}"; return 1; }
    need_root mkdir -p "$CRAFTCTL_SYSTEMD_DIR" || return 1
    need_root cp "$src" "$dest" || return 1
    need_root chmod 644 "$dest" || return 1
    need_root systemctl daemon-reload || return 1
}

# Wait for a unit to reach a state (active/inactive) with timeout seconds.
wait_for_state() {
    local name="$1" want="$2" timeout="${3:-30}"
    local i=0
    while [[ $i -lt $timeout ]]; do
        if [[ "$want" == "active" ]] && service_is_active "$name"; then
            return 0
        fi
        if [[ "$want" == "inactive" ]] && ! service_is_active "$name"; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}
