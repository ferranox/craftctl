#!/usr/bin/env bash
# craftctl - lib/server
# Per-server filesystem layout, config generation and locking.
# shellcheck shell=bash

server_lock_file() {
    local name="$1"
    printf '%s\n' "${CRAFTCTL_LOCK_DIR}/craftctl-${name}.lock"
}

# Ensure the lock directory is usable by the invoking user.
# Fresh installs may leave /var/lock/craftctl root-owned; fix it via
# need_root (consistent with other setup steps) or fall back to a per-user
# tmp directory so normal users are never blocked. Updates CRAFTCTL_LOCK_DIR
# when falling back.
ensure_lock_dir() {
    local dir="${CRAFTCTL_LOCK_DIR}"
    if [[ -d "$dir" ]] && [[ -w "$dir" ]]; then
        return 0
    fi
    if mkdir -p "$dir" 2>/dev/null && [[ -w "$dir" ]]; then
        return 0
    fi
    if need_root mkdir -p "$dir" 2>/dev/null; then
        need_root chmod 1777 "$dir" 2>/dev/null || true
        if [[ -w "$dir" ]]; then
            return 0
        fi
    fi
    local fallback
    fallback="${TMPDIR:-/tmp}/craftctl-locks-$(id -u)"
    if mkdir -p "$fallback" 2>/dev/null && [[ -w "$fallback" ]]; then
        CRAFTCTL_LOCK_DIR="$fallback"
        export CRAFTCTL_LOCK_DIR
        return 0
    fi
    return 1
}

with_server_lock() {
    local name="$1"
    shift
    if ! ensure_lock_dir; then
        log_warn "Lock directory unavailable; running '${name}' operation without lock."
        "$@"
        return $?
    fi
    local lock
    lock="$(server_lock_file "$name")"
    # Braces group the redirection so a failure message cannot leak past
    # 2>/dev/null (a bare `exec 9>"$lock" 2>/dev/null` still prints the
    # redirection error to the original stderr).
    if ! { exec 9>"$lock"; } 2>/dev/null; then
        log_error "Cannot create lock file '${lock}': permission denied."
        log_error "Fix: sudo mkdir -p '${CRAFTCTL_LOCK_DIR}' && sudo chmod 1777 '${CRAFTCTL_LOCK_DIR}'"
        return 1
    fi
    if has_cmd flock; then
        if ! flock -n 9 2>/dev/null; then
            log_error "Another operation is already running for server '${name}'."
            exec 9>&- 2>/dev/null || true
            return 1
        fi
    fi
    "$@"
    local rc=$?
    exec 9>&- 2>/dev/null || true
    return $rc
}

server_jar_path() {
    local name="$1"
    printf '%s\n' "$(server_dir "$name")/server.jar"
}

server_log_path() {
    local name="$1"
    printf '%s\n' "$(server_dir "$name")/logs/latest.log"
}

# Run tar against server/backup data, acting as the minecraft user when the
# invoking user cannot access the paths directly (preserves ownership, so no
# later chown pass is needed for tar-created files).
tar_data() {
    if tar "$@" 2>/dev/null; then
        return 0
    fi
    if has_cmd sudo; then
        if sudo -u "$CRAFTCTL_MC_USER" tar "$@"; then
            return 0
        fi
    fi
    tar "$@"
}

# Newest-first full paths of a server's backup archives (sudo-aware: backup
# dirs are minecraft-owned on real installs).
list_backup_files() {
    local name="$1"
    local dir="${CRAFTCTL_BACKUP_ROOT}/${name}"
    local raw=""
    if [[ -r "$dir" && -x "$dir" ]]; then
        raw="$(ls -1t "$dir" 2>/dev/null || true)"
    else
        raw="$(need_root ls -1t "$dir" 2>/dev/null || true)"
    fi
    [[ -n "$raw" ]] || return 0
    local f
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        if [[ "$f" == "${name}-"*".tar.gz" ]]; then
            printf '%s/%s\n' "$dir" "$f"
        fi
    done <<< "$raw"
}

generate_rcon_password() {
    if has_cmd openssl; then
        openssl rand -hex 16
    else
        tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32
        printf '\n'
    fi
}

rcon_password_file() {
    local name="$1"
    printf '%s\n' "${CRAFTCTL_ETC}/servers/${name}.rcon"
}

store_rcon_password() {
    local name="$1" pass="$2"
    local f
    f="$(rcon_password_file "$name")"
    need_root mkdir -p "$(dirname "$f")" 2>/dev/null || return 1
    # Owned by the invoking admin (only craftctl ever reads it); the game
    # server itself uses server.properties, not this file.
    printf '%s\n' "$pass" | priv_write "$f" 600 "$(invoking_user)" || return 1
}

read_rcon_password() {
    local name="$1"
    local f
    f="$(rcon_password_file "$name")"
    path_exists "$f" 2>/dev/null || return 1
    # first line, strip whitespace/newlines
    priv_cat "$f" 2>/dev/null | head -n 1 | tr -d '\r\n'
}

write_server_config() {
    local name="$1" mc_version="$2" build="$3" memory="$4"
    local sport="$5" rport="$6" java_bin="$7" jvm_flags="$8"
    local conf
    conf="$(server_conf_path "$name")"
    # No secrets in here (ports/versions/paths), so keep it world-readable:
    # routine commands (list/info) can then read it without sudo.
    {
        printf '# craftctl server configuration for %s\n' "$name"
        printf '# Managed by craftctl - edits may be overwritten by `craftctl --update-server`.\n'
        printf 'SERVER_NAME=%s\n' "$name"
        printf 'MC_VERSION=%s\n' "$mc_version"
        printf 'PAPER_BUILD=%s\n' "$build"
        printf 'MEMORY=%s\n' "$memory"
        printf 'SERVER_PORT=%s\n' "$sport"
        printf 'RCON_PORT=%s\n' "$rport"
        printf 'JAVA_BIN=%s\n' "$java_bin"
        printf 'JVM_FLAGS=%s\n' "$jvm_flags"
        printf 'CREATED=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } | priv_write "$conf" 644 "${CRAFTCTL_MC_USER}:${CRAFTCTL_MC_USER}" || return 1
}

default_jvm_flags() {
    # Aikar-inspired G1 defaults, conservative for Raspberry Pi.
    printf '%s' "-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem"
}

# Write or update server.properties for a server directory.
# server.properties holds the RCON password, so it stays 640/minecraft.
write_server_properties() {
    local dir="$1" sport="$2" rport="$3" rcon_pass="$4"
    local f="${dir}/server.properties"
    local work
    work="$(mktemp)" || return 1
    if path_exists "$f" 2>/dev/null; then
        # Best-effort backup of custom settings (never prompt for sudo here;
        # the authoritative write below escalates if needed).
        cp -f "$f" "${f}.bak.$(date +%s)" 2>/dev/null || true
        priv_cat "$f" 2>/dev/null > "$work" || { rm -f "$work"; return 1; }
        if [[ ! -s "$work" ]]; then
            log_error "Cannot read '${f}' to update it."
            rm -f "$work"
            return 1
        fi
        set_prop() {
            local k="$1" v="$2" file="$3"
            if grep -q "^${k}=" "$file"; then
                sed -i "s|^${k}=.*|${k}=${v}|" "$file"
            else
                printf '%s=%s\n' "$k" "$v" >> "$file"
            fi
        }
        set_prop "server-port" "$sport" "$work"
        set_prop "enable-rcon" "true" "$work"
        set_prop "rcon.port" "$rport" "$work"
        set_prop "rcon.password" "$rcon_pass" "$work"
        # Bind RCON to localhost only.
        if grep -q "^rcon.ip=" "$work"; then
            sed -i "s|^rcon.ip=.*|rcon.ip=127.0.0.1|" "$work"
        else
            printf 'rcon.ip=127.0.0.1\n' >> "$work"
        fi
    else
        cat > "$work" <<EOF
# Minecraft server properties (managed by craftctl)
server-port=${sport}
enable-rcon=true
rcon.port=${rport}
rcon.password=${rcon_pass}
rcon.ip=127.0.0.1
enable-query=false
white-list=false
motd=craftctl ${dir##*/} - Powered by PaperMC
max-players=20
view-distance=10
simulation-distance=10
difficulty=easy
gamemode=survival
spawn-protection=16
online-mode=true
EOF
    fi
    priv_install "$work" "$f" 640 "${CRAFTCTL_MC_USER}:${CRAFTCTL_MC_USER}" || { rm -f "$work"; return 1; }
    rm -f "$work"
}

accept_eula() {
    local dir="$1"
    printf '#By changing the setting below to TRUE you are indicating your agreement to our EULA (https://aka.ms/MinecraftEULA).\n#Managed by craftctl - server created %s\neula=true\n' "$(date -u +%Y-%m-%d)" \
        | priv_write "${dir}/eula.txt" 644 "${CRAFTCTL_MC_USER}:${CRAFTCTL_MC_USER}"
}
