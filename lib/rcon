#!/usr/bin/env bash
# craftctl - lib/rcon
# RCON client handling.
#
# Strategy:
#   1. Prefer `mcrcon` when installed (small, purpose-built).
#   2. Otherwise use python3 with a minimal RCON implementation (stdlib only),
#      treated as an external utility, not part of the Bash application logic.
#   3. Whitelist operations fall back to editing whitelist.json + server.properties
#      when the server is offline.
# RCON is always bound to 127.0.0.1; passwords are never printed.
# shellcheck shell=bash

rcon_host_for() {
    printf '127.0.0.1\n'
}

rcon_port_for() {
    local name="$1"
    local conf
    conf="$(server_conf_path "$name")"
    conf_get "$conf" RCON_PORT 2>/dev/null || printf '25575\n'
}

# Send a single RCON command. Usage: rcon_send <server> <command...>
# Prints server response to stdout, returns non-zero on failure.
rcon_send() {
    local name="$1"
    shift
    local cmd="$*"
    [[ -n "$cmd" ]] || { log_error "No RCON command given."; return 1; }
    local port pass
    port="$(rcon_port_for "$name")"
    pass="$(read_rcon_password "$name" 2>/dev/null || true)"
    if [[ -z "$pass" ]]; then
        log_error "No RCON credentials found for server '${name}'."
        return 1
    fi
    if has_cmd mcrcon; then
        # mcrcon reads password from env/file without exposing on ps in newer versions.
        local out rc
        out="$(MCRCON_PASS="$pass" mcrcon -H 127.0.0.1 -P "$port" "$cmd" 2>&1)"
        rc=$?
        # Scrub any accidental password echo (mcrcon never echoes it, but be safe).
        out="${out//$pass/[redacted]}"
        printf '%s\n' "$out"
        return $rc
    fi
    if has_cmd python3; then
        CRAFTCTL_RCON_PASS="$pass" python3 - "$port" "$cmd" <<'PYEOF'
import socket, struct, sys
host = "127.0.0.1"
port = int(sys.argv[1])
cmd = sys.argv[2]
password = __import__("os").environ.get("CRAFTCTL_RCON_PASS", "")
def packet(req_id, req_type, body):
    b = body.encode("utf-8") + b"\x00\x00"
    return struct.pack("<iii", 4 + 4 + len(b), req_id, req_type) + b
try:
    s = socket.create_connection((host, port), timeout=10)
except Exception as e:
    print(f"RCON connection failed: {e}", file=sys.stderr)
    sys.exit(1)
try:
    s.sendall(packet(1, 3, password))
    hdr = s.recv(12)
    if len(hdr) < 12:
        print("RCON auth: short response", file=sys.stderr)
        sys.exit(1)
    size, rid, rtype = struct.unpack("<iii", hdr)
    rest = b""
    while len(rest) < size - 8:
        chunk = s.recv(size - 8 - len(rest))
        if not chunk:
            break
        rest += chunk
    if rid == -1:
        print("RCON authentication failed (bad password).", file=sys.stderr)
        sys.exit(1)
    s.sendall(packet(2, 2, cmd))
    # Read one response packet (whitelist commands fit easily).
    hdr = s.recv(12)
    if len(hdr) < 12:
        print("RCON: empty response", file=sys.stderr)
        sys.exit(0)
    size, rid, rtype = struct.unpack("<iii", hdr)
    data = b""
    while len(data) < size - 8:
        chunk = s.recv(size - 8 - len(data))
        if not chunk:
            break
        data += chunk
    text = data[:-2].decode("utf-8", errors="replace") if len(data) >= 2 else ""
    print(text)
except Exception as e:
    print(f"RCON error: {e}", file=sys.stderr)
    sys.exit(1)
finally:
    try:
        s.close()
    except Exception:
        pass
PYEOF
        return $?
    fi
    log_error "No RCON client available: install 'mcrcon' or 'python3'."
    log_error "Hint: sudo apt-get install -y mcrcon  (or python3)."
    return 1
}

rcon_available() {
    has_cmd mcrcon || has_cmd python3
}

# --- Offline whitelist.json helpers ---------------------------------------

whitelist_file() {
    local name="$1"
    printf '%s\n' "$(server_dir "$name")/whitelist.json"
}

# Ensure whitelist.json exists and is a valid JSON array.
ensure_whitelist_file() {
    local name="$1"
    local f
    f="$(whitelist_file "$name")"
    if path_exists "$f" 2>/dev/null; then
        if priv_cat "$f" 2>/dev/null | jq -e 'type == "array"' >/dev/null 2>&1; then
            return 0
        fi
        log_error "whitelist.json for '${name}' is corrupt (not a JSON array)."
        return 1
    fi
    # Player names are not secret; keep world-readable so offline listing
    # works without sudo.
    printf '[]\n' | priv_write "$f" 644 "${CRAFTCTL_MC_USER}:${CRAFTCTL_MC_USER}" || return 1
}

offline_whitelist_add() {
    local name="$1" user="$2"
    local uuid="$3"
    local f
    f="$(whitelist_file "$name")"
    ensure_whitelist_file "$name" || return 1
    if priv_cat "$f" 2>/dev/null | jq -e --arg u "$user" '.[] | select(.name == $u)' >/dev/null 2>&1; then
        log_info "Player '${user}' is already whitelisted on '${name}'."
        return 0
    fi
    # uuid may be empty (offline mode without Mojang lookup); store entry anyway.
    local tmp
    tmp="$(mktemp)" || return 1
    if [[ -n "$uuid" ]]; then
        priv_cat "$f" 2>/dev/null | jq --arg u "$user" --arg id "$uuid" '. + [{uuid: $id, name: $u}]' > "$tmp" || { rm -f "$tmp"; return 1; }
    else
        priv_cat "$f" 2>/dev/null | jq --arg u "$user" '. + [{name: $u}]' > "$tmp" || { rm -f "$tmp"; return 1; }
    fi
    priv_install "$tmp" "$f" 644 "${CRAFTCTL_MC_USER}:${CRAFTCTL_MC_USER}" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
}

offline_whitelist_remove() {
    local name="$1" user="$2"
    local f
    f="$(whitelist_file "$name")"
    ensure_whitelist_file "$name" || return 1
    if ! priv_cat "$f" 2>/dev/null | jq -e --arg u "$user" '.[] | select(.name == $u)' >/dev/null 2>&1; then
        log_info "Player '${user}' is not whitelisted on '${name}'."
        return 0
    fi
    local tmp
    tmp="$(mktemp)" || return 1
    priv_cat "$f" 2>/dev/null | jq --arg u "$user" 'map(select(.name != $u))' > "$tmp" || { rm -f "$tmp"; return 1; }
    priv_install "$tmp" "$f" 644 "${CRAFTCTL_MC_USER}:${CRAFTCTL_MC_USER}" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
}

# Look up a Mojang UUID for a username (best effort, may fail offline).
mojang_uuid_for() {
    local user="$1"
    local out
    out="$(curl -fsSL --max-time 15 -H "User-Agent: craftctl/${CRAFTCTL_VERSION} (https://github.com/ferranox/craftctl)" \
        "https://api.mojang.com/users/profiles/minecraft/${user}" 2>/dev/null || true)"
    if [[ -n "$out" ]]; then
        local id
        id="$(printf '%s' "$out" | jq -r '.id // empty' 2>/dev/null)"
        if [[ -n "$id" ]]; then
            # Mojang returns undashed; convert to dashed form.
            printf '%s-%s-%s-%s-%s\n' "${id:0:8}" "${id:8:4}" "${id:12:4}" "${id:16:4}" "${id:20:12}"
            return 0
        fi
    fi
    return 1
}

server_online() {
    local name="$1"
    service_is_active "$name"
}
