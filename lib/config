#!/usr/bin/env bash
# craftctl - lib/config
# Configuration loading/saving for global and per-server config.
# shellcheck shell=bash

# Global config path: $CRAFTCTL_ETC/craftctl.conf
global_conf_path() {
    printf '%s\n' "${CRAFTCTL_ETC}/craftctl.conf"
}

server_conf_path() {
    local name="$1"
    printf '%s\n' "${CRAFTCTL_DATA}/${name}/config.conf"
}

server_dir() {
    local name="$1"
    printf '%s\n' "${CRAFTCTL_DATA}/${name}"
}

# Load KEY=VALUE file safely (no eval of arbitrary code): only simple assignments.
load_conf_file() {
    local file="$1"
    [[ -f "$file" ]] || return 1
    local line key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        # strip leading/trailing whitespace
        line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            key="${BASH_REMATCH[1]}"
            value="${BASH_REMATCH[2]}"
            # strip surrounding quotes if present
            if [[ ${#value} -ge 2 ]]; then
                if [[ "$value" == \"*\" ]]; then
                    value="${value:1:${#value}-2}"
                elif [[ "$value" == \'*\' ]]; then
                    value="${value:1:${#value}-2}"
                fi
            fi
            printf -v "$key" '%s' "$value"
        fi
    done < "$file"
}

# Read a single key from a conf file without polluting environment.
# Falls back to sudo when the file is not directly readable (real installs
# keep server configs owned by the minecraft user).
conf_get() {
    local file="$1" key="$2"
    path_exists "$file" 2>/dev/null || return 1
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ "$line" == "${key}="* ]]; then
            local value="${line#*=}"
            if [[ ${#value} -ge 2 ]]; then
                if [[ "$value" == \"*\" ]]; then
                    value="${value:1:${#value}-2}"
                elif [[ "$value" == \'*\' ]]; then
                    value="${value:1:${#value}-2}"
                fi
            fi
            printf '%s\n' "$value"
            return 0
        fi
    done < <(priv_cat "$file" 2>/dev/null)
    return 1
}

# Set or update a single KEY=VALUE in a conf file atomically.
# Works whether or not the file is directly writable (escalates via sudo
# when needed) and preserves the existing file mode/owner.
conf_set() {
    local file="$1" key="$2" value="$3"
    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        log_error "Invalid config key '${key}'."
        return 1
    fi
    # escape: values are stored raw; newlines are rejected.
    if [[ "$value" == *$'\n'* ]]; then
        log_error "Invalid config value: must not contain newlines."
        return 1
    fi
    local work
    work="$(mktemp)" || return 1
    if path_exists "$file" 2>/dev/null; then
        if ! priv_cat "$file" 2>/dev/null | awk -v k="$key" -v v="$value" '
            BEGIN { done=0 }
            {
                line=$0
                stripped=line
                sub(/^[ \t]+/, "", stripped)
                if (stripped ~ "^" k "=" && done==0) {
                    print k "=" v
                    done=1
                } else {
                    print line
                }
            }
            END { if (done==0) print k "=" v }
        ' > "$work"; then
            rm -f "$work"
            return 1
        fi
        if [[ ! -s "$work" ]]; then
            # Could not read the existing file (privilege failure after the
            # existence check); refuse to overwrite it with a single key.
            log_error "Cannot read '${file}' to update it."
            rm -f "$work"
            return 1
        fi
    else
        printf '%s=%s\n' "$key" "$value" > "$work" || { rm -f "$work"; return 1; }
    fi
    # Preserve existing mode/owner; default 644 for new files.
    local mode="644" owner=""
    local stat_out=""
    stat_out="$(stat -c '%a %U %G' "$file" 2>/dev/null || need_root stat -c '%a %U %G' "$file" 2>/dev/null || true)"
    if [[ -n "$stat_out" ]]; then
        local s_mode s_user s_group
        read -r s_mode s_user s_group <<< "$stat_out"
        [[ -n "${s_mode:-}" ]] && mode="$s_mode"
        [[ -n "${s_user:-}" && -n "${s_group:-}" ]] && owner="${s_user}:${s_group}"
    fi
    priv_install "$work" "$file" "$mode" "$owner" || { rm -f "$work"; return 1; }
    rm -f "$work"
}

# Load global config with defaults.
load_global_config() {
    DEFAULT_VERSION="${DEFAULT_VERSION:-}"
    DEFAULT_MEMORY="${DEFAULT_MEMORY:-2G}"
    DEFAULT_PORT="${DEFAULT_PORT:-25565}"
    BACKUP_RETENTION="${BACKUP_RETENTION:-7}"
    JAVA_DIR="${JAVA_DIR:-}"
    local f
    f="$(global_conf_path)"
    if [[ -f "$f" ]]; then
        # Use conf_get to avoid arbitrary execution.
        local v
        v="$(conf_get "$f" DEFAULT_VERSION 2>/dev/null)" && DEFAULT_VERSION="$v"
        v="$(conf_get "$f" DEFAULT_MEMORY 2>/dev/null)" && DEFAULT_MEMORY="$v"
        v="$(conf_get "$f" DEFAULT_PORT 2>/dev/null)" && DEFAULT_PORT="$v"
        v="$(conf_get "$f" BACKUP_RETENTION 2>/dev/null)" && BACKUP_RETENTION="$v"
        v="$(conf_get "$f" JAVA_DIR 2>/dev/null)" && JAVA_DIR="$v"
    fi
    export DEFAULT_VERSION DEFAULT_MEMORY DEFAULT_PORT BACKUP_RETENTION JAVA_DIR
    # Sanitize numeric globals: a hand-edited config must not break port
    # allocation or backup pruning.
    if ! [[ "$BACKUP_RETENTION" =~ ^[0-9]+$ ]] || [[ "$BACKUP_RETENTION" -lt 1 ]]; then
        BACKUP_RETENTION=7
    fi
    if ! [[ "$DEFAULT_PORT" =~ ^[0-9]+$ ]] || [[ "$DEFAULT_PORT" -lt 1024 || "$DEFAULT_PORT" -gt 65535 ]]; then
        DEFAULT_PORT=25565
    fi
    export BACKUP_RETENTION DEFAULT_PORT
}

# Load per-server config into variables with SERVER_ prefix to avoid collisions.
# Sets: SERVER_NAME, SERVER_VERSION, SERVER_MEMORY, SERVER_PORT, SERVER_RCON_PORT,
#       SERVER_JAVA, SERVER_JVM_FLAGS, SERVER_BUILD
load_server_config() {
    local name="$1"
    local conf
    conf="$(server_conf_path "$name")"
    [[ -f "$conf" ]] || return 1
    SERVER_NAME="$name"
    SERVER_VERSION="$(conf_get "$conf" MC_VERSION 2>/dev/null || true)"
    SERVER_MEMORY="$(conf_get "$conf" MEMORY 2>/dev/null || true)"
    SERVER_PORT="$(conf_get "$conf" SERVER_PORT 2>/dev/null || true)"
    SERVER_RCON_PORT="$(conf_get "$conf" RCON_PORT 2>/dev/null || true)"
    SERVER_JAVA="$(conf_get "$conf" JAVA_BIN 2>/dev/null || true)"
    SERVER_JVM_FLAGS="$(conf_get "$conf" JVM_FLAGS 2>/dev/null || true)"
    SERVER_BUILD="$(conf_get "$conf" PAPER_BUILD 2>/dev/null || true)"
    export SERVER_NAME SERVER_VERSION SERVER_MEMORY SERVER_PORT SERVER_RCON_PORT
    export SERVER_JAVA SERVER_JVM_FLAGS SERVER_BUILD
}

server_exists() {
    local name="$1"
    local d f
    d="${CRAFTCTL_DATA}/${name}"
    f="${d}/config.conf"
    if [[ -d "$d" && -f "$f" ]]; then
        return 0
    fi
    # Real installs keep server dirs owned by the minecraft user, which the
    # invoking user cannot traverse directly.
    need_root test -d "$d" 2>/dev/null && need_root test -f "$f" 2>/dev/null
}

list_servers() {
    local data="${CRAFTCTL_DATA}"
    [[ -e "$data" ]] || return 0
    local raw=""
    if [[ -r "$data" && -x "$data" ]]; then
        raw="$(ls -1 "$data" 2>/dev/null || true)"
    else
        raw="$(need_root ls -1 "$data" 2>/dev/null || true)"
    fi
    [[ -n "$raw" ]] || return 0
    local base
    while IFS= read -r base; do
        [[ -n "$base" ]] || continue
        if path_exists "${data}/${base}/config.conf" 2>/dev/null; then
            printf '%s\n' "$base"
        fi
    done <<< "$raw" | sort
}

# Find a free game port and rcon port, starting from defaults.
# Probes the actual socket table when `ss` is missing (minimal images).
_port_in_use() {
    local port="$1"
    if has_cmd ss; then
        ss -ltn 2>/dev/null | grep -q ":${port} "
    else
        ( : </dev/tcp/127.0.0.1/"$port" ) 2>/dev/null
    fi
}

find_free_port() {
    local start="${1:-25565}"
    local used="$2"
    local port="$start"
    local tries=0
    while [[ $tries -lt 1000 ]]; do
        if ! printf '%s\n' "$used" | grep -qx "$port"; then
            if ! _port_in_use "$port"; then
                printf '%s\n' "$port"
                return 0
            fi
        fi
        port=$((port + 1))
        tries=$((tries + 1))
    done
    return 1
}

collect_used_ports() {
    local name s
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        s="$(conf_get "${CRAFTCTL_DATA}/${name}/config.conf" SERVER_PORT 2>/dev/null || true)"
        [[ -n "$s" ]] && printf '%s\n' "$s"
        s="$(conf_get "${CRAFTCTL_DATA}/${name}/config.conf" RCON_PORT 2>/dev/null || true)"
        [[ -n "$s" ]] && printf '%s\n' "$s"
    done < <(list_servers)
}

port_in_use_by_other() {
    local port="$1" exclude="${2:-}"
    local name s
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        [[ "$name" == "$exclude" ]] && continue
        s="$(conf_get "${CRAFTCTL_DATA}/${name}/config.conf" SERVER_PORT 2>/dev/null || true)"
        [[ "$s" == "$port" ]] && return 0
        s="$(conf_get "${CRAFTCTL_DATA}/${name}/config.conf" RCON_PORT 2>/dev/null || true)"
        [[ "$s" == "$port" ]] && return 0
    done < <(list_servers)
    return 1
}
