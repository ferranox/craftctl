#!/usr/bin/env bash
# craftctl command: setup
# shellcheck shell=bash

cmd_setup() {
    log_info "craftctl setup: checking environment..."
    check_supported_os || return 1
    log_info "Detected: ${CRAFTCTL_OS_ID} ${CRAFTCTL_OS_VERSION} (${CRAFTCTL_ARCH})"
    check_systemd || return 1
    if ! has_cmd sudo && ! is_root; then
        log_error "sudo is required for setup (you are not root and sudo is missing)."
        return 1
    fi
    install_dependencies || return 1

    # Create minecraft user.
    if ! id "$CRAFTCTL_MC_USER" >/dev/null 2>&1; then
        log_info "Creating system user '${CRAFTCTL_MC_USER}'..."
        need_root useradd --system --home-dir /var/lib/craftctl \
            --shell /usr/sbin/nologin --comment "craftctl Minecraft server user" \
            "$CRAFTCTL_MC_USER" || return 1
    else
        log_info "User '${CRAFTCTL_MC_USER}' already exists."
    fi

    # Directories.
    for d in "$CRAFTCTL_ETC" "$CRAFTCTL_ETC/servers" "$CRAFTCTL_DATA" \
             "$CRAFTCTL_BACKUP_ROOT" "$CRAFTCTL_LOCK_DIR"; do
        need_root mkdir -p "$d" || return 1
    done
    # Permissions are applied via need_root (not `if is_root`): setup is
    # normally run as a sudo-capable user, not as root itself.
    need_root chown -R "${CRAFTCTL_MC_USER}:root" "$CRAFTCTL_DATA" "$CRAFTCTL_BACKUP_ROOT" 2>/dev/null || true
    need_root chown -R "root:${CRAFTCTL_MC_USER}" "$CRAFTCTL_ETC" 2>/dev/null || true
    need_root chmod 2750 "$CRAFTCTL_ETC" 2>/dev/null || true
    need_root chmod 2750 "$CRAFTCTL_DATA" 2>/dev/null || true
    need_root chmod 2750 "$CRAFTCTL_BACKUP_ROOT" 2>/dev/null || true
    # Lock dir must stay writable by invoking users (sticky bit like /tmp).
    need_root chmod 1777 "$CRAFTCTL_LOCK_DIR" 2>/dev/null || true

    # Global config defaults.
    local gconf
    gconf="$(global_conf_path)"
    if [[ ! -f "$gconf" ]]; then
        log_info "Writing default global configuration..."
        local latest=""
        latest="$(papermc_latest_version 2>/dev/null || true)"
        {
            printf '# craftctl global configuration\n'
            printf '# https://github.com/ferranox/craftctl\n'
            printf 'DEFAULT_VERSION=%s\n' "$latest"
            printf 'DEFAULT_MEMORY=2G\n'
            printf 'DEFAULT_PORT=25565\n'
            printf 'BACKUP_RETENTION=7\n'
            printf 'JAVA_DIR=\n'
        } > "${gconf}.new" || return 1
        need_root mv "${gconf}.new" "$gconf" 2>/dev/null || mv "${gconf}.new" "$gconf" || return 1
        need_root chmod 644 "$gconf" 2>/dev/null || chmod 644 "$gconf" || true
    else
        log_info "Global configuration already exists; leaving it untouched."
    fi

    # Ensure a Java runtime for the default version if known.
    load_global_config
    if [[ -n "${DEFAULT_VERSION:-}" ]]; then
        local major bin
        major="$(java_required_for_mc "$DEFAULT_VERSION" 2>/dev/null || true)"
        if [[ -n "$major" ]]; then
            if bin="$(find_java_for_major "$major" 2>/dev/null)"; then
                log_info "Java ${major} available: ${bin}"
            else
                log_info "Installing default Java ${major} for Paper ${DEFAULT_VERSION}..."
                install_java_for_major "$major" >/dev/null || log_warn "Default Java install failed; it will be installed on first server creation."
            fi
        fi
    fi

    log_ok "Setup complete. Create a server with: craftctl --create <name>"
}
