#!/usr/bin/env bash
# craftctl command: backup
# shellcheck shell=bash

cmd_backup() {
    local name="" keep=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --keep) keep="${2:-}"; shift 2 ;;
            --keep=*) keep="${1#--keep=}"; shift ;;
            --help|-h) printf 'Usage: craftctl --backup <name> [--keep N]\n'; return 0 ;;
            -*) log_error "Unknown option for --backup: $1"; return 2 ;;
            *) if [[ -z "$name" ]]; then name="$1"; else log_error "Unexpected argument: $1"; return 2; fi; shift ;;
        esac
    done
    [[ -n "$name" ]] || { log_error "Usage: craftctl --backup <name> [--keep N]"; return 2; }
    validate_server_name "$name" || return 1
    server_exists "$name" || { log_error "Server '${name}' does not exist."; return 1; }
    if [[ -n "$keep" ]]; then
        if [[ ! "$keep" =~ ^[0-9]+$ ]] || [[ "$keep" -lt 1 ]]; then
            log_error "Invalid --keep value '${keep}': must be a positive integer."
            return 1
        fi
    else
        load_global_config
        keep="${BACKUP_RETENTION:-7}"
    fi
    with_server_lock "$name" _do_backup "$name" "$keep"
}

_do_backup() {
    local name="$1" keep="$2"
    local dir backup_dir ts file
    dir="$(server_dir "$name")"
    backup_dir="${CRAFTCTL_BACKUP_ROOT}/${name}"
    need_root mkdir -p "$backup_dir" 2>/dev/null || mkdir -p "$backup_dir" || return 1
    ts="$(date +%Y%m%d-%H%M%S)"

    # Safe snapshot: if online, disable autosave, save-all, then tar; re-enable after.
    local online=0
    if service_is_active "$name" 2>/dev/null; then
        online=1
    fi
    if [[ $online -eq 1 ]]; then
        log_info "Server is online; freezing world for consistent snapshot..."
        rcon_send "$name" "save-off" >/dev/null 2>&1 || log_warn "Could not send save-off (continuing anyway)."
        rcon_send "$name" "save-all flush" >/dev/null 2>&1 || rcon_send "$name" "save-all" >/dev/null 2>&1 || true
        sleep 2
    fi

    file="${backup_dir}/${name}-${ts}.tar.gz"
    log_info "Creating backup ${file}..."
    local rc=0
    # Exclude logs and cache to keep backups small on Raspberry Pi.
    if is_root; then
        runuser -u "$CRAFTCTL_MC_USER" -- tar -czf "$file" \
            --exclude='./logs' --exclude='./cache' --exclude='./*.log.gz' \
            -C "$dir" ./ 2>/dev/null || rc=$?
    else
        tar -czf "$file" --exclude='./logs' --exclude='./cache' \
            --exclude='./*.log.gz' -C "$dir" ./ 2>/dev/null || rc=$?
    fi

    if [[ $online -eq 1 ]]; then
        rcon_send "$name" "save-on" >/dev/null 2>&1 || true
    fi
    if [[ $rc -ne 0 ]]; then
        log_error "Backup failed for '${name}'."
        rm -f "$file"
        return 1
    fi
    if ! tar -tzf "$file" >/dev/null 2>&1; then
        log_error "Backup verification failed (archive is corrupt): ${file}"
        rm -f "$file"
        return 1
    fi
    if is_root && id "$CRAFTCTL_MC_USER" >/dev/null 2>&1; then
        chown "${CRAFTCTL_MC_USER}:root" "$file" 2>/dev/null || true
    fi
    log_ok "Backup created: ${file}"
    _prune_backups "$name" "$keep"
}

_prune_backups() {
    local name="$1" keep="$2"
    local backup_dir="${CRAFTCTL_BACKUP_ROOT}/${name}"
    [[ -d "$backup_dir" ]] || return 0
    local files=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && files+=("$f")
    done < <(ls -1t "${backup_dir}"/"${name}"-*.tar.gz 2>/dev/null)
    local total=${#files[@]}
    if [[ $total -gt $keep ]]; then
        local i
        for (( i=keep; i<total; i++ )); do
            log_info "Pruning old backup: ${files[$i]}"
            rm -f "${files[$i]}"
        done
    fi
}
