#!/usr/bin/env bash
# craftctl command: start
# shellcheck shell=bash

cmd_start() {
    local target
    target="$(_lifecycle_target "$@")" || return $?
    if [[ "$target" == "ALL" ]]; then
        local s rc=0
        while IFS= read -r s; do
            [[ -n "$s" ]] || continue
            _start_one "$s" || rc=1
        done < <(list_servers)
        return $rc
    fi
    _start_one "$target"
}

_lifecycle_target() {
    if [[ $# -eq 0 ]]; then
        log_error "Missing server name. Usage with <name> or --all."
        return 2
    fi
    if [[ "$1" == "--all" ]]; then
        printf 'ALL\n'
        return 0
    fi
    if [[ "$1" == -* ]]; then
        log_error "Unknown option: $1 (expected <name> or --all)."
        return 2
    fi
    validate_server_name "$1" || return 1
    if ! server_exists "$1"; then
        log_error "Server '$1' does not exist."
        return 1
    fi
    printf '%s\n' "$1"
}

_start_one() {
    local name="$1"
    if service_is_active "$name" 2>/dev/null; then
        log_info "Server '${name}' is already running."
        return 0
    fi
    log_info "Starting server '${name}'..."
    if ! service_start "$name"; then
        log_error "Failed to start '${name}'. Check: systemctl status craftctl@${name} / journalctl -u craftctl@${name}"
        return 1
    fi
    if wait_for_state "$name" active 20 2>/dev/null; then
        log_ok "Server '${name}' started."
    else
        log_warn "Start issued for '${name}' but service is not active yet; check logs."
    fi
}
