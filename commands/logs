#!/usr/bin/env bash
# craftctl command: logs
# shellcheck shell=bash

cmd_logs() {
    local name="" lines=100 follow=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --lines) lines="${2:-}"; shift 2 ;;
            --lines=*) lines="${1#--lines=}"; shift ;;
            -n) lines="${2:-}"; shift 2 ;;
            --follow|-f) follow=1; shift ;;
            --help|-h) printf 'Usage: craftctl --logs <name> [--lines N] [--follow]\n'; return 0 ;;
            -*) log_error "Unknown option for --logs: $1"; return 2 ;;
            *) if [[ -z "$name" ]]; then name="$1"; else log_error "Unexpected argument: $1"; return 2; fi; shift ;;
        esac
    done
    [[ -n "$name" ]] || { log_error "Usage: craftctl --logs <name> [--lines N] [--follow]"; return 2; }
    validate_server_name "$name" || return 1
    server_exists "$name" || { log_error "Server '${name}' does not exist."; return 1; }
    if [[ ! "$lines" =~ ^[0-9]+$ ]]; then
        log_error "Invalid --lines value '${lines}'."
        return 1
    fi
    # Prefer journalctl for the systemd unit, fall back to latest.log.
    local unit
    unit="$(service_name_for "$name")"
    if has_cmd journalctl && systemctl_cmd status "$unit" >/dev/null 2>&1; then
        if [[ $follow -eq 1 ]]; then
            journalctl -u "$unit" -n "$lines" -f --no-pager 2>/dev/null \
                || need_root journalctl -u "$unit" -n "$lines" -f --no-pager
        else
            journalctl -u "$unit" -n "$lines" --no-pager 2>/dev/null \
                || need_root journalctl -u "$unit" -n "$lines" --no-pager 2>/dev/null \
                || _file_logs "$name" "$lines" "$follow"
        fi
        return 0
    fi
    _file_logs "$name" "$lines" "$follow"
}

_file_logs() {
    local name="$1" lines="$2" follow="$3"
    local f
    f="$(server_log_path "$name")"
    if ! path_exists "$f" 2>/dev/null; then
        log_error "No log file found at ${f}. Is the server installed correctly?"
        return 1
    fi
    if [[ "$follow" -eq 1 ]]; then
        if [[ -r "$f" ]]; then
            tail -n "$lines" -f "$f"
        else
            need_root tail -n "$lines" -f "$f"
        fi
    else
        if [[ -r "$f" ]]; then
            tail -n "$lines" "$f"
        else
            need_root tail -n "$lines" "$f"
        fi
    fi
}
