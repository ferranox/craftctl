#!/usr/bin/env bash
# craftctl command: restart
# shellcheck shell=bash

cmd_restart() {
    local target
    if declare -F _lifecycle_target >/dev/null 2>&1; then
        target="$(_lifecycle_target "$@")" || return $?
    else
        if [[ $# -eq 0 ]]; then log_error "Missing server name. Usage with <name> or --all."; return 2; fi
        if [[ "$1" == "--all" ]]; then target="ALL"; else
            validate_server_name "$1" || return 1
            server_exists "$1" || { log_error "Server '$1' does not exist."; return 1; }
            target="$1"
        fi
    fi
    if [[ "$target" == "ALL" ]]; then
        local s rc=0
        while IFS= read -r s; do
            [[ -n "$s" ]] || continue
            _restart_one "$s" || rc=1
        done < <(list_servers)
        return $rc
    fi
    _restart_one "$target"
}

_restart_one() {
    local name="$1"
    log_info "Restarting server '${name}'..."
    rcon_send "$name" "save-all" >/dev/null 2>&1 || true
    if ! service_restart "$name"; then
        log_error "Failed to restart '${name}'."
        return 1
    fi
    if wait_for_state "$name" active 30 2>/dev/null; then
        log_ok "Server '${name}' restarted."
    else
        log_warn "Restart issued for '${name}' but service is not active yet."
    fi
}
